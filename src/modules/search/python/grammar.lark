start           : _unit ( _sep _unit )*

_unit           : line
                | _paren_a
                | _char_a
                | pseudo

line            : "[" ( _paren_a | _char_a | pseudo ) ( _sep ( _paren_a | _char_a | pseudo ) )* "]"

_paren_a        : paren
                | paren_asterisk
paren_asterisk  : "*" paren
paren           : "(" _unit ( _sep _unit )* ")" [wildcard]

_char_a         : char
                | char_asterisk
char_asterisk   : "*" char

char            : spec+ [wildcard]
                | indicator [wildcard]
pseudo          : "p"

indicator       : [ALIGNMENT] INDIC_TYPE spec+

spec            : "v" NUMBER                    -> value
                | "s" NUMBER                    -> sign_variant
                | "g" NUMBER                    -> grapheme
                | "c" NUMBER                    -> glyph
                | "x"                           -> valuex
                | "X"                           -> signx
                | "n"                           -> numberx

wildcard        : "@" NUMBER

_sep            : ( " " | wordcon | compoundcon | bar | colon | ellipsis | wordbreak | compoundbreak | linebreak | inheritcon )+

wordcon         : "-"
compoundcon     : "="
ellipsis        : "…"
colon           : ":"
wordbreak       : ";"
compoundbreak   : ","
linebreak       : "/"
bar             : "|"
inheritcon      : "~"

TYPE            : /[vsgcxXnp]/
NUMBER          : /[1-9][0-9]*|0/
INDIC_TYPE      : /[DP]/
ALIGNMENT       : /[<>]/