start           : _unit ( _sep _unit )*

_unit           : line
                | _paren_a
                | _char_a
                | pseudo

line            : "[" ( _paren_a | _char_a | pseudo ) ( _sep ( _paren_a | _char_a | pseudo ) )* "]"

_paren_a        : paren
                | paren_asterisk
paren_asterisk  : "*" paren
paren           : "(" _unit ( _sep _unit )* ")" [wildcard]

_char_a         : char
                | char_asterisk
char_asterisk   : "*" char

char            : spec+ [wildcard]
                | indicator [wildcard]
pseudo          : "p"

indicator       : [ALIGNMENT] INDIC_TYPE spec+

spec            : "v" NUMBER                    -> value
                | "s" NUMBER                    -> sign_variant
                | "S" NUMBER                    -> sign
                | "g" NUMBER                    -> grapheme
                | "c" NUMBER                    -> glyph
                | "x"                           -> signx
                | "X"                           -> graphemex
                | "n"                           -> numberx

wildcard        : "@" NUMBER

_sep            : ( " " | wordcon | compoundcon | bar | colon | ellipsis | wordbreak | compoundbreak | linebreak )+

wordcon         : _WORDCON
compoundcon     : _COMPOUNDCON
ellipsis        : "…"
colon           : ":"
wordbreak       : _WORDBREAK
compoundbreak   : _COMPOUNDBREAK
linebreak       : "//"
bar             : "|"

NUMBER          : /[1-9][0-9]*|0/
INDIC_TYPE      : /[DP]/
ALIGNMENT       : /[<>]/

_COMPOUNDBREAK.1: ";;"
_WORDBREAK.0    : ";"
_COMPOUNDCON.1  : "--"
_WORDCON.0      : "-"